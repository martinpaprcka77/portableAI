# --- Secrets (NIKDY necommitovat) ------------------------------------------
.env
env/.env
**/.env
!**/.env.example

# --- Node -------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/

# --- Runtime data -----------------------------------------------------------
logs/*.log
data/*
!data/.gitkeep
bin/*
!bin/.gitkeep

# --- Runtime agenta (Reasonix) ----------------------------------------------
# Stav běžícího agenta: tasky, snapshoty a transkripty sessions. Není součástí
# workspace - stejně jako logs/, data/ a bin/ se needituje a necommituje.
.reasonix/
session-*.md

# --- Editor / OS ------------------------------------------------------------
*.local.json
*.swp
Thumbs.db
Desktop.ini
.DS_Store

# --- Temporary --------------------------------------------------------------
*.tmp
*.bak
*.orig
~$*
