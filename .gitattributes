# Normalizace řádkových koncovek.
# Zdroj pravdy: METAPROMPT.md — CRLF pro .ps1/.cmd/.bat, LF pro ostatní.
* text=auto

# PowerShell a Windows shell
*.ps1    text eol=crlf
*.psm1   text eol=crlf
*.psd1   text eol=crlf
*.cmd    text eol=crlf
*.bat    text eol=crlf

# Dokumentace a konfigurace (LF)
*.md     text eol=lf
*.json   text eol=lf
*.toml   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.svg    text eol=lf

# Binary
*.png    binary
*.jpg    binary
*.ico    binary
*.exe    binary
*.zip    binary
