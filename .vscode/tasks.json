{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Test workspace",
      "type": "shell",
      "command": "pwsh.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Test-Workspace.ps1"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Diagnostics",
      "type": "shell",
      "command": "pwsh.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Get-AiStackInfo.ps1"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Setup stack",
      "type": "shell",
      "command": "pwsh.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Setup-DeepSeekStack.ps1"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Repair repo",
      "type": "shell",
      "command": "pwsh.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Repair-Repo.ps1"
      ],
      "group": "build",
      "problemMatcher": []
    }
  ]
}
